# Test token only here. duffel.py and duffel_reshop_test.py refuse anything that
# isn't duffel_test_ prefixed; the app refuses a duffel_live_ token outside
# APP_ENV=staging, and on staging unless one of the live flags below is true.
DUFFEL_TOKEN=duffel_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# dev | staging | production — missing or anything else means production.
# APP_ENV=dev

# Staging only (either flag true anywhere else stops the app at startup):
# DUFFEL_LIVE_SEARCH_ENABLED=true      # live offer requests (the /eligibility page)
# DUFFEL_LIVE_ORDERS_ENABLED=false     # live order create / change / cancel
# STAGING_MAX_MONTHLY_SEARCHES=1400
# STAGING_MAX_ORDER_USD=
# STAGING_MAX_DAILY_USD=
# STAGING_ALLOWED_EMAILS=you@example.com,colleague@example.com
